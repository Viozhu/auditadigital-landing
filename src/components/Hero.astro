---
import { PRICE_LAUNCH, PRICE_NEXT, PRICE_FINAL, DELIVERY_HOURS, GUARANTEE_MIN_FAULTS } from '../config/site';

interface Props {
  stripeLink: string;
  slots: number;
}
const { stripeLink, slots } = Astro.props;
---
<section class="relative py-16 pb-24 overflow-hidden border-b border-line" id="top">
  <!-- Grid background -->
  <div class="absolute inset-0 hero-grid-bg"></div>

  <div class="relative z-10 mx-auto max-w-[1240px] px-6">
    <!-- Badges -->
    <div class="flex gap-[10px] mb-8 flex-wrap">
      <span class="inline-flex items-center gap-2 bg-green text-ink font-mono text-[11px] px-[10px] py-[6px] rounded-xs uppercase tracking-[0.06em]">
        <span class="w-[6px] h-[6px] rounded-full bg-ink" style="animation: pulse 1.6s infinite;"></span>
        {slots} slots disponibles esta semana a ${PRICE_LAUNCH}
      </span>
      <span class="inline-flex items-center gap-2 border border-line-2 text-mute-2 font-mono text-[11px] px-[10px] py-[6px] rounded-xs uppercase tracking-[0.06em]">
        // lanzamiento · cohorte 01
      </span>
    </div>

    <!-- H1 -->
    <h1 class="font-display font-bold leading-[0.9] tracking-[-0.045em] mb-8 max-w-[14ch]"
        style="font-size: clamp(56px, 11vw, 168px);">
      <span class="strike-line">Deja de adivinar.</span><br/>
      Audita tu web<br/>
      <span class="text-blue">hoy mismo.</span>
    </h1>

    <!-- Deck grid -->
    <div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr] gap-12 mt-12 pt-8 border-t border-line items-end">
      <!-- Left: lede + CTA -->
      <div>
        <p class="text-[20px] text-mute-2 max-w-[48ch] leading-[1.45]">
          Tu web es un colador de dinero. Te decimos <strong class="text-paper font-medium">dónde están los agujeros</strong> en SEO, negocio, competencia y Meta Ads. Informe entregado en <strong class="text-paper font-medium">48h</strong>. Sin reuniones. Sin contraseñas.
        </p>
        <div class="flex gap-3 mt-7 flex-wrap">
          <a href={stripeLink} data-cta="hero"
             class="inline-flex items-center justify-center gap-3 bg-blue text-paper px-[30px] py-[22px] rounded-s font-display font-semibold text-[18px] tracking-[-0.005em] hover:bg-[#4a73ff] hover:-translate-y-px transition-all shadow-[inset_0_-2px_0_rgba(0,0,0,0.25)]">
            Quiero mi auditoría por ${PRICE_LAUNCH} <span class="font-mono font-medium">→</span>
          </a>
          <a href="#video"
             class="inline-flex items-center justify-center gap-3 border border-line-2 text-paper px-[22px] py-[15px] rounded-s font-display font-semibold text-[16px] hover:border-paper hover:bg-white/[0.04] transition-all">
            Ver demo · 60s <span class="font-mono font-medium">↓</span>
          </a>
        </div>
      </div>

      <!-- Right: price card -->
      <div class="bg-ink-2 border border-line rounded-s p-6">
        <div class="flex items-center justify-between mb-[14px] font-mono text-[11px] text-mute-2 uppercase tracking-[0.1em]">
          <span>// precio de lanzamiento</span>
          <span class="text-green">● online</span>
        </div>
        <div class="flex items-start gap-1 leading-[0.85]">
          <span class="font-display font-bold text-[144px] tracking-[-0.06em]">{PRICE_LAUNCH}</span>
          <span class="font-display font-bold text-[64px] tracking-[-0.04em] mt-[14px]">$</span>
        </div>
        <div class="font-mono text-[11px] text-mute mt-2 mb-[18px] leading-[1.6]">
          pago único · sin suscripción<br/>
          próxima subida: ${PRICE_NEXT} &nbsp;·&nbsp; pvp final ${PRICE_FINAL}
        </div>
        <a href={stripeLink} data-cta="hero-card"
           class="flex items-center justify-center gap-3 w-full bg-blue text-paper px-[22px] py-[16px] rounded-s font-display font-semibold text-[16px] hover:bg-[#4a73ff] hover:-translate-y-px transition-all shadow-[inset_0_-2px_0_rgba(0,0,0,0.25)]">
          Comprar auditoría <span class="font-mono font-medium">→</span>
        </a>
      </div>
    </div>

    <!-- KPI strip -->
    <div class="mt-12 border-t border-b border-line py-[14px] grid grid-cols-2 md:grid-cols-4 gap-6 font-mono text-[12px] text-mute-2">
      <div class="flex items-center gap-[10px]"><span class="text-green text-[14px]">▲</span><span><strong class="text-paper font-display text-[14px] font-semibold tracking-[-0.01em]">{DELIVERY_HOURS}h</strong> de entrega</span></div>
      <div class="flex items-center gap-[10px]"><span class="text-green text-[14px]">▲</span><span><strong class="text-paper font-display text-[14px] font-semibold tracking-[-0.01em]">4 pilares</strong> auditados</span></div>
      <div class="flex items-center gap-[10px]"><span class="text-green text-[14px]">▲</span><span><strong class="text-paper font-display text-[14px] font-semibold tracking-[-0.01em]">{GUARANTEE_MIN_FAULTS} fallos</strong> mínimo o devolvemos</span></div>
      <div class="flex items-center gap-[10px]"><span class="text-green text-[14px]">▲</span><span><strong class="text-paper font-display text-[14px] font-semibold tracking-[-0.01em]">0</strong> reuniones de venta</span></div>
    </div>
  </div>
</section>
