---
import { pillars } from '../config/site';
---
<section class="py-24 border-b border-line" id="pilares">
  <div class="mx-auto max-w-[1240px] px-6">
    <div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-12 mb-14 items-start">
      <div class="font-mono text-[11px] text-mute-2 uppercase tracking-[0.12em] pt-3">
        <span class="text-orange">04</span> · Producto
      </div>
      <div>
        <h2 class="font-display font-bold leading-[0.95] tracking-[-0.035em] mb-5 max-w-[22ch]"
            style="font-size: clamp(36px, 5vw, 64px);">
          Los 4 pilares de <span class="text-blue">AuditaDigital.</span>
        </h2>
        <p class="text-mute-2 text-[18px] max-w-[56ch] leading-[1.5]">
          Cada auditoría cubre los 4 frentes que decidieron tu última factura. <strong class="text-paper font-medium">Datos extraídos con herramientas pro, lectura 100% humana.</strong>
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {pillars.map(p => (
        <div class="pillar-card relative flex flex-col border border-line rounded-s p-8 min-h-[360px] overflow-hidden"
             style="background: linear-gradient(180deg, var(--color-ink-3) 0%, var(--color-ink-2) 100%);">
          <!-- Blue top line -->
          <div class="absolute top-0 left-0 right-0 h-px"
               style="background: linear-gradient(90deg, transparent, #2e5bff 50%, transparent); opacity: 0.4;"></div>
          <div class="flex items-center justify-between mb-9">
            <span class="font-mono text-[12px] text-mute tracking-[0.08em]">
              <strong class="text-blue">{p.num}</strong> / 04 · pilar
            </span>
            <span class="w-[44px] h-[44px] border border-line-2 rounded-s grid place-items-center text-green font-mono font-bold text-[13px] bg-ink">
              {p.ico}
            </span>
          </div>
          <h3 class="font-display font-bold text-[32px] leading-[1.05] tracking-[-0.025em] mb-[14px]">{p.title}</h3>
          <p class="text-mute-2 text-[15px] leading-[1.55] mb-6 max-w-[50ch]">{p.desc}</p>
          <ul class="mt-auto grid grid-cols-2 gap-[10px_20px] font-mono text-[12px] border-t border-dashed border-line-2 pt-[18px]">
            {p.checks.map(c => (
              <li class="flex gap-[10px] items-start text-mute-2">
                <span class="text-green flex-shrink-0">→</span>{c}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
