---
import { trustBadges, PRICE_LAUNCH } from '../config/site';

interface Props {
  stripeLink: string;
}
const { stripeLink } = Astro.props;
---
<section class="relative flex items-center bg-ink overflow-hidden border-b border-line py-24" style="min-height: 92vh;">
  <!-- Grid background -->
  <div class="absolute inset-0 final-grid-bg"></div>

  <div class="relative z-10 mx-auto max-w-[1240px] px-6 text-center w-full">
    <div class="font-mono text-[11px] text-mute-2 uppercase tracking-[0.12em] mb-8">
      <span class="text-orange">10</span> · ÚLTIMA PARADA
    </div>
    <h2 class="font-display font-bold leading-[0.9] tracking-[-0.045em] mx-auto mb-8 max-w-[16ch]"
        style="font-size: clamp(56px, 10vw, 144px);">
      En 48 horas tendrás la hoja de ruta para que tu web deje de ser un <span class="text-blue">gasto.</span>
    </h2>
    <p class="text-[20px] text-mute-2 max-w-[52ch] mx-auto mb-10 leading-[1.45]">
      Cero reuniones de venta. Cero PDFs ilegibles. Solo <strong class="text-paper font-medium">la lista de cosas concretas</strong> que mover el lunes para que tus euros dejen de irse por el desagüe.
    </p>
    <a href={stripeLink} data-cta="final"
       class="inline-flex items-center justify-center gap-3 bg-blue text-paper px-9 py-[26px] rounded-s font-display font-semibold text-[20px] hover:bg-[#4a73ff] hover:-translate-y-px transition-all shadow-[inset_0_-2px_0_rgba(0,0,0,0.25)]">
      Quiero mi auditoría por ${PRICE_LAUNCH} <span class="font-mono font-medium">→</span>
    </a>
    <div class="flex gap-8 justify-center mt-8 flex-wrap font-mono text-[12px] text-mute-2 uppercase tracking-[0.08em]">
      {trustBadges.map(item => (
        <span class="inline-flex items-center gap-2">
          <span class="text-green font-bold">✓</span>{item}
        </span>
      ))}
    </div>
  </div>
</section>
