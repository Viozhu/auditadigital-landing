          <div style="display:flex;flex-direction:column;gap:7px">
            <div id="s4i0" style="background:white;border-radius:8px;padding:10px 14px;box-shadow:0 1px 3px rgba(0,0,0,.07);display:flex;gap:10px;align-items:flex-start;opacity:0;transform:translateX(-14px);transition:opacity .35s,transform .35s">
              <span style="flex-shrink:0;padding:3px 9px;border-radius:4px;font-size:10px;font-weight:700;background:#ef4444;color:white;text-transform:uppercase;margin-top:1px">ALTO</span>
              <div>
                <div style="font-size:12px;font-weight:700;color:#111827;margin-bottom:2px">Instalar Meta Pixel + Google Tag Manager hoy</div>
                <div style="font-size:11px;color:#6b7280;line-height:1.4">Sin pixel, no hay retargeting de personas que vieron propiedades. Es el mayor ROI disponible: 2 horas de setup, impacto inmediato en costo por lead.</div>
              </div>
            </div>
            <div id="s4i1" style="background:white;border-radius:8px;padding:10px 14px;box-shadow:0 1px 3px rgba(0,0,0,.07);display:flex;gap:10px;align-items:flex-start;opacity:0;transform:translateX(-14px);transition:opacity .35s,transform .35s">
              <span style="flex-shrink:0;padding:3px 9px;border-radius:4px;font-size:10px;font-weight:700;background:#ef4444;color:white;text-transform:uppercase;margin-top:1px">ALTO</span>
              <div>
                <div style="font-size:12px;font-weight:700;color:#111827;margin-bottom:2px">Crear páginas SEO por barrio: /palermo · /recoleta · /belgrano · /caballito</div>
                <div style="font-size:11px;color:#6b7280;line-height:1.4">1 día de trabajo, impacto en 4–8 semanas. Captura búsquedas locales de alto intento de compra sin inversión publicitaria recurrente.</div>
              </div>
            </div>
            <div id="s4i2" style="background:white;border-radius:8px;padding:10px 14px;box-shadow:0 1px 3px rgba(0,0,0,.07);display:flex;gap:10px;align-items:flex-start;opacity:0;transform:translateX(-14px);transition:opacity .35s,transform .35s">
              <span style="flex-shrink:0;padding:3px 9px;border-radius:4px;font-size:10px;font-weight:700;background:#ef4444;color:white;text-transform:uppercase;margin-top:1px">ALTO</span>
              <div>
                <div style="font-size:12px;font-weight:700;color:#111827;margin-bottom:2px">Reclamar Google Business y subir 10 fotos de propiedades</div>
                <div style="font-size:11px;color:#6b7280;line-height:1.4">30 minutos de setup. Apareces en el local pack de "inmobiliaria + barrio". Tu competencia ya está ahí — cada día sin ficha es posición perdida.</div>
              </div>
            </div>
            <div id="s4i3" style="background:white;border-radius:8px;padding:10px 14px;box-shadow:0 1px 3px rgba(0,0,0,.07);display:flex;gap:10px;align-items:flex-start;opacity:0;transform:translateX(-14px);transition:opacity .35s,transform .35s">
              <span style="flex-shrink:0;padding:3px 9px;border-radius:4px;font-size:10px;font-weight:700;background:#f97316;color:white;text-transform:uppercase;margin-top:1px">MED</span>
              <div>
                <div style="font-size:12px;font-weight:700;color:#111827;margin-bottom:2px">Convertir fotos a WebP y activar lazy load</div>
                <div style="font-size:11px;color:#6b7280;line-height:1.4">Sube velocidad móvil de 38 a +70. El 68% de búsquedas inmobiliarias en Argentina es móvil. Mejora directa en posición y en tasa de rebote.</div>
              </div>
            </div>
            <div id="s4i4" style="background:white;border-radius:8px;padding:10px 14px;box-shadow:0 1px 3px rgba(0,0,0,.07);display:flex;gap:10px;align-items:flex-start;opacity:0;transform:translateX(-14px);transition:opacity .35s,transform .35s">
              <span style="flex-shrink:0;padding:3px 9px;border-radius:4px;font-size:10px;font-weight:700;background:#f97316;color:white;text-transform:uppercase;margin-top:1px">MED</span>
              <div>
                <div style="font-size:12px;font-weight:700;color:#111827;margin-bottom:2px">Agregar schema RealEstateAgent con precio y barrio</div>
                <div style="font-size:11px;color:#6b7280;line-height:1.4">Google muestra rich results con rating, reseñas y propiedades para inmobiliarias con schema. Ocupa más espacio visual y aumenta CTR sin subir posición.</div>
              </div>
            </div>
          </div>
        </div>

      </div><!-- /vf-content -->

      <!-- ── Bottom bar ──────────────────────────────────── -->
      <div style="position:absolute;bottom:0;left:0;right:0;height:36px;background:rgba(17,24,39,.9);display:flex;align-items:center;padding:0 16px;gap:12px;z-index:30;box-sizing:border-box">
        <div style="flex:1;height:3px;background:#374151;border-radius:2px;overflow:hidden">
          <div id="vf-progress" style="height:100%;background:#a3ff12;width:0%;transition:width .3s linear"></div>
        </div>
        <span style="font-family:monospace;font-size:11px;color:#6b7280;white-space:nowrap">
          <b id="vf-time" style="color:#a3ff12">00:00</b> / 00:40
        </span>
      </div>

      <!-- ── Play overlay ────────────────────────────────── -->
      <div id="vf-overlay" style="position:absolute;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(13,13,15,.6);backdrop-filter:blur(3px);transition:opacity .4s">
        <button id="vf-play" style="width:80px;height:80px;border-radius:50%;background:#a3ff12;border:none;cursor:pointer;display:grid;place-items:center;box-shadow:0 0 0 16px rgba(163,255,18,.12);transition:transform .2s" aria-label="Reproducir demo">
          <svg viewBox="0 0 24 24" fill="#0d0d0f" width="28" height="28" style="margin-left:4px">
            <polygon points="6,4 20,12 6,20"/>
          </svg>
        </button>
        <div style="margin-top:16px;font-family:monospace;font-size:10px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.1em">// MUESTRA</div>
        <strong style="display:block;color:#fff;font-size:14px;margin-top:6px;font-weight:600">Walkthrough del informe interactivo</strong>
      </div>

      <!-- ── Replay overlay ─────────────────────────────── -->
      <div id="vf-replay-overlay" style="display:none;position:absolute;inset:0;z-index:50;flex-direction:column;align-items:center;justify-content:center;background:rgba(13,13,15,.6);backdrop-filter:blur(3px);transition:opacity .4s;opacity:0">
        <button id="vf-replay" style="width:80px;height:80px;border-radius:50%;background:#a3ff12;border:none;cursor:pointer;display:grid;place-items:center;box-shadow:0 0 0 16px rgba(163,255,18,.12);transition:transform .2s" aria-label="Reiniciar demo">
          <svg viewBox="0 0 24 24" fill="#0d0d0f" width="26" height="26">
            <path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
          </svg>
        </button>
        <div style="margin-top:16px;font-family:monospace;font-size:10px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.1em">// FIN DEL DEMO</div>
        <strong style="display:block;color:#fff;font-size:14px;margin-top:6px;font-weight:600">¿Querés un informe así para tu negocio?</strong>
      </div>

    </div><!-- /vf -->
  </div>
</section>

<script>
(function () {
  /* ─── Scene schedule ─────────────────────────────────── */
  const SCENES = [
    {
      start: 0, end: 8,
      id: 'vf-s1',
      label: '01 / Dashboard',
      onEnter(push) {
        let v = 0;
        const scoreEl = document.getElementById('s1-score');
        const iv = setInterval(() => {
          v = Math.min(v + 3, 42);
          if (scoreEl) scoreEl.textContent = String(v);
          if (v >= 42) clearInterval(iv);
        }, 30);

        ['s1c0','s1c1','s1c2','s1c3'].forEach((id) => {
          push(setTimeout(() => {
            const el = document.getElementById(id);
            if (el) { el.style.opacity = '1'; el.style.transform = 'translateY(0)'; }
          }, 300));
        });
        push(setTimeout(() => {
          const el = document.getElementById('s1-sum');
          if (el) el.style.opacity = '1';
        }, 700));
        push(setTimeout(() => {
          const el = document.getElementById('s1-iss');
          if (el) el.style.opacity = '1';
        }, 1400));
      },
    },
    {
      start: 8, end: 18,
      id: 'vf-s2',
      label: '02 / SEO Audit',
      onEnter(push) {
        ['s2i0','s2i1','s2i2','s2i3'].forEach((id, i) => {
          push(setTimeout(() => {
            const el = document.getElementById(id);
            if (el) { el.style.opacity = '1'; el.style.transform = 'translateX(0)'; }
          }, 300 + i * 550));
        });
      },
    },
    {
      start: 18, end: 27,
      id: 'vf-s3',
      label: '03 / Meta Ads',
      onEnter(push) {
        ['s3c0','s3c1','s3c2','s3c3'].forEach((id, i) => {
          push(setTimeout(() => {
            const el = document.getElementById(id);
            if (el) { el.style.opacity = '1'; el.style.transform = 'translateY(0)'; }
          }, 300 + i * 400));
        });
      },
    },
    {
      start: 27, end: 40,
      id: 'vf-s4',
      label: '04 / Quick Wins',
      onEnter(push) {
        ['s4i0','s4i1','s4i2','s4i3','s4i4'].forEach((id, i) => {
          push(setTimeout(() => {
            const el = document.getElementById(id);
            if (el) { el.style.opacity = '1'; el.style.transform = 'translateX(0)'; }
          }, 300 + i * 500));
        });
      },
    },
  ];

  /* ─── DOM refs ───────────────────────────────────────── */
  const overlay       = document.getElementById('vf-overlay');
  const replayOverlay = document.getElementById('vf-replay-overlay');
  const playBtn       = document.getElementById('vf-play');
  const replayBtn     = document.getElementById('vf-replay');
  const progressEl    = document.getElementById('vf-progress');
  const timeEl        = document.getElementById('vf-time');
  const tagEl         = document.getElementById('vf-tag');

  /* ─── State ──────────────────────────────────────────── */
  let startTs      = null;
  let rafId        = null;
  let currentScene = -1;
  let timers       = [];

  function fmt(sec) {
    const m = Math.floor(sec / 60).toString().padStart(2, '0');
    const s = Math.floor(sec % 60).toString().padStart(2, '0');
    return m + ':' + s;
  }

  function clearTimers() { timers.forEach(clearTimeout); timers = []; }

  function resetSceneEl(id) {
    const el = document.getElementById(id);
    if (el) { el.style.opacity = '0'; el.style.pointerEvents = 'none'; }
  }

  function resetAllAnimatables() {
    const sc = document.getElementById('s1-score');
    if (sc) sc.textContent = '00';

    [['s1c0','s1c1','s1c2','s1c3'], ['s3c0','s3c1','s3c2','s3c3']].forEach((ids) => {
      ids.forEach((id) => {
        const el = document.getElementById(id);
        if (el) { el.style.opacity = '0'; el.style.transform = 'translateY(10px)'; }
      });
    });
    ['s1-sum','s1-iss'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.style.opacity = '0';
    });
    ['s2i0','s2i1','s2i2','s2i3'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) { el.style.opacity = '0'; el.style.transform = 'translateX(-12px)'; }
    });
    ['s4i0','s4i1','s4i2','s4i3','s4i4'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) { el.style.opacity = '0'; el.style.transform = 'translateX(-14px)'; }
    });
  }

  function showScene(idx) {
    if (idx === currentScene) return;
    if (currentScene >= 0) resetSceneEl(SCENES[currentScene].id);
    currentScene = idx;
    clearTimers();

    const scene = SCENES[idx];
    const el = document.getElementById(scene.id);
    if (el) { el.style.opacity = '1'; el.style.pointerEvents = 'auto'; }

    if (tagEl) {
      tagEl.style.opacity = '0';
      timers.push(setTimeout(() => {
        tagEl.textContent = scene.label;
        tagEl.style.opacity = '1';
      }, 250));
    }

    const push = (t) => timers.push(t);
    timers.push(setTimeout(() => scene.onEnter(push), 150));
  }

  function tick(ts) {
    if (!startTs) startTs = ts;
    const elapsed = (ts - startTs) / 1000;

    if (elapsed >= 40) {
      if (progressEl) progressEl.style.width = '100%';
      if (timeEl) timeEl.textContent = '00:40';
      showReplay();
      return;
    }

    if (progressEl) progressEl.style.width = (elapsed / 40 * 100).toFixed(2) + '%';
    if (timeEl) timeEl.textContent = fmt(elapsed);

    const idx = SCENES.findIndex(s => elapsed >= s.start && elapsed < s.end);
    if (idx !== -1) showScene(idx);

    rafId = requestAnimationFrame(tick);
  }

  function showReplay() {
    if (!replayOverlay) return;
    replayOverlay.style.display = 'flex';
    requestAnimationFrame(() => { replayOverlay.style.opacity = '1'; });
  }

  function startDemo() {
    cancelAnimationFrame(rafId);
    clearTimers();
    if (currentScene >= 0) resetSceneEl(SCENES[currentScene].id);
    currentScene = -1;
    startTs = null;
    resetAllAnimatables();

    if (progressEl) progressEl.style.width = '0%';
    if (timeEl) timeEl.textContent = '00:00';
    if (tagEl) { tagEl.textContent = ''; tagEl.style.opacity = '0'; }

    if (overlay) { overlay.style.opacity = '0'; setTimeout(() => { overlay.style.display = 'none'; }, 420); }
    if (replayOverlay) { replayOverlay.style.opacity = '0'; setTimeout(() => { replayOverlay.style.display = 'none'; }, 420); }

    rafId = requestAnimationFrame(tick);
  }

  function hoverIn(btn) { btn.style.transform = 'scale(1.06)'; }
  function hoverOut(btn) { btn.style.transform = ''; }

  playBtn?.addEventListener('click', startDemo);
  playBtn?.addEventListener('mouseenter', () => hoverIn(playBtn));
  playBtn?.addEventListener('mouseleave', () => hoverOut(playBtn));

  replayBtn?.addEventListener('click', startDemo);
  replayBtn?.addEventListener('mouseenter', () => hoverIn(replayBtn));
  replayBtn?.addEventListener('mouseleave', () => hoverOut(replayBtn));
})();
</script>
