---
/**
 * <Favicon /> — incluye en <head> de tu Layout.astro (o BaseHead.astro).
 *
 * Asume que copiaste:
 *   public/favicon.svg
 *   public/favicon.ico         (opcional, para IE/legacy)
 *   public/favicon-32.png
 *   public/favicon-180.png     (apple-touch-icon)
 *   public/favicon-192.png     (android)
 *   public/favicon-512.png     (PWA splash)
 *   public/site.webmanifest    (opcional)
 */
---
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#050505" />
