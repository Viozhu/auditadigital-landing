---
import { testimonials } from '../config/site';
---
<section class="py-24 border-b border-line" id="testimonios">
  <div class="mx-auto max-w-[1240px] px-6">
    <div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-12 mb-14 items-start">
      <div class="font-mono text-[11px] text-mute-2 uppercase tracking-[0.12em] pt-3">
        <span class="text-orange">07</span> · Casos
      </div>
      <div>
        <h2 class="font-display font-bold leading-[0.95] tracking-[-0.035em] mb-5 max-w-[22ch]"
            style="font-size: clamp(36px, 5vw, 64px);">
          Tres clientes. Tres facturas <span class="text-blue">cambiadas.</span>
        </h2>
        <p class="text-mute-2 text-[18px] max-w-[56ch] leading-[1.5]">
          Lo que pasó después de aplicar las primeras 5 acciones de la hoja de ruta. <strong class="text-paper font-medium">Sin maquillar números.</strong>
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {testimonials.map(t => (
        <div class="bg-ink-2 border border-line rounded-s p-7 flex flex-col gap-6 min-h-[360px]">
          <div class="text-green font-mono tracking-[0.12em]">{t.stars}</div>
          <p class="font-display font-medium text-[19px] leading-[1.35] tracking-[-0.015em] flex-grow"
             set:html={t.quote}></p>
          <span class="inline-flex self-start items-center gap-2 px-[10px] py-[6px] rounded-xs font-mono text-[11px] text-green tracking-[0.04em]"
                style="background: rgba(163,255,18,0.08); border: 1px solid rgba(163,255,18,0.3);">
            {t.result}
          </span>
          <div class="flex items-center gap-[14px] pt-[18px] border-t border-dashed border-line-2">
            <div class="w-[44px] h-[44px] rounded-full grid place-items-center font-display font-bold text-[16px] flex-shrink-0"
                 style={t.avatarStyle}>
              {t.initials}
            </div>
            <div>
              <div class="font-display font-semibold text-[15px] tracking-[-0.01em]">{t.name}</div>
              <div class="font-mono text-[11px] text-mute-2 mt-0.5">{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
