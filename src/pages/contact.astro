---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contacto — AuditaDigital"
  description="¿Tenés dudas antes de contratar? Escribinos. Te respondemos en menos de 24 horas."
>
  <main class="bg-ink min-h-screen">
    <div class="mx-auto max-w-[1240px] px-6 py-16 md:py-24">

      <a href="/" class="inline-flex items-center gap-2 font-mono text-[11px] text-mute-2 uppercase tracking-[0.08em] hover:text-paper transition-colors mb-12">
        ← Volver al inicio
      </a>

      <!-- Header -->
      <div class="mb-16 border-b border-line pb-10">
        <p class="font-mono text-[11px] text-orange uppercase tracking-[0.08em] mb-3">// Contacto</p>
        <h1 class="font-display font-bold text-paper leading-none tracking-[-0.03em]" style="font-size: clamp(2.5rem, 6vw, 4rem);">¿Tenés alguna duda?</h1>
        <p class="font-body text-body-l text-mute mt-3 max-w-[52ch]">Escribinos. Sin spam, sin llamadas. Te respondemos en menos de 24 horas.</p>
      </div>

      <!-- Body grid -->
      <div class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-12 items-start">

        <!-- Sidebar -->
        <aside class="flex flex-col gap-6">
          <div class="bg-ink-2 border border-line rounded-m p-6">
            <p class="font-mono text-[10px] text-mute uppercase tracking-[0.12em] mb-4">// Qué esperar</p>
            <ul class="flex flex-col gap-4">
              <li class="flex gap-3 items-start">
                <span class="font-mono text-[11px] text-green mt-[2px]">01</span>
                <div>
                  <p class="font-display font-semibold text-paper text-[13px] leading-snug">Respuesta en &lt; 24h</p>
                  <p class="font-body text-small text-mute mt-1">Días hábiles. Sin bots ni respuestas automáticas.</p>
                </div>
              </li>
              <li class="flex gap-3 items-start border-t border-line pt-4">
                <span class="font-mono text-[11px] text-green mt-[2px]">02</span>
                <div>
                  <p class="font-display font-semibold text-paper text-[13px] leading-snug">Sin reuniones de venta</p>
                  <p class="font-body text-small text-mute mt-1">Si tu consulta requiere una llamada, lo coordinamos por mail.</p>
                </div>
              </li>
              <li class="flex gap-3 items-start border-t border-line pt-4">
                <span class="font-mono text-[11px] text-green mt-[2px]">03</span>
                <div>
                  <p class="font-display font-semibold text-paper text-[13px] leading-snug">Email directo</p>
                  <p class="font-body text-small text-mute mt-1">
                    <a href="mailto:hola@auditadigital.com" class="text-blue hover:text-paper transition-colors">hola@auditadigital.com</a>
                  </p>
                </div>
              </li>
            </ul>
          </div>

          <div class="bg-ink-2 border border-line rounded-m p-6">
            <p class="font-mono text-[10px] text-mute uppercase tracking-[0.12em] mb-3">// Para qué sirve</p>
            <ul class="flex flex-col gap-2">
              {[
                "Dudas antes de comprar",
                "Consultas post-entrega",
                "Casos especiales o sectores",
                "Propuestas de partnership",
              ].map(item => (
                <li class="flex gap-2 items-center font-body text-small text-mute-2">
                  <span class="text-orange text-[10px]">·</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </aside>

        <!-- Form card -->
        <div class="bg-ink-2 border border-line rounded-m p-8 md:p-10">

          <form id="contact-form" class="flex flex-col gap-6" novalidate>

            <div class="flex items-center justify-between pb-5 border-b border-line">
              <p class="font-mono text-[11px] text-mute-2 uppercase tracking-[0.12em]">Formulario de contacto</p>
              <p class="font-mono text-[11px] text-orange">01 · Contacto</p>
            </div>

            <div id="prefill-banner" class="hidden items-start gap-3 bg-blue/8 border border-blue/25 rounded-s px-4 py-3">
              <span class="font-mono text-blue text-[13px] mt-[1px] shrink-0">✦</span>
              <p class="font-body text-small text-blue">Formulario pre-completado desde tu mini-auditoría. Revisá los datos y enviá cuando estés listo.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="field-group">
                <label for="nombre" class="field-label">Nombre</label>
                <input id="nombre" name="nombre" type="text" required autocomplete="name"
                  placeholder="Tu nombre completo"
                  class="field-input" />
              </div>
              <div class="field-group">
                <label for="email" class="field-label">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email"
                  placeholder="tu@email.com"
                  class="field-input" />
              </div>
            </div>

            <div class="field-group">
              <label for="asunto" class="field-label">Asunto</label>
              <input id="asunto" name="asunto" type="text" required
                placeholder="¿De qué se trata tu consulta?"
                class="field-input" />
            </div>

            <div class="field-group">
              <label for="mensaje" class="field-label">Mensaje</label>
              <textarea id="mensaje" name="mensaje" required rows="6"
                placeholder="Contanos en detalle. Cuanto más contexto des, mejor podemos ayudarte."
                class="field-input resize-none"></textarea>
            </div>

            <div id="form-error" class="hidden flex items-start gap-3 bg-orange/8 border border-orange/25 rounded-s px-4 py-3">
              <span class="font-mono text-orange text-[13px] mt-[1px] shrink-0">×</span>
              <p class="font-body text-small text-orange error-text"></p>
            </div>

            <div class="flex items-center justify-between pt-2 border-t border-line">
              <p class="font-mono text-[11px] text-mute">Respuesta en &lt; 24h hábiles</p>
              <button type="submit" id="submit-btn" class="submit-btn">
                <span id="btn-text">Enviar mensaje</span>
                <span id="btn-icon" class="font-mono">→</span>
              </button>
            </div>

          </form>

          <div id="success-msg" class="hidden flex flex-col items-start gap-4 py-4">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-green shrink-0" style="box-shadow: 0 0 0 4px rgba(163,255,18,0.15);"></span>
              <p class="font-mono text-[11px] text-green uppercase tracking-[0.1em]">// Mensaje enviado</p>
            </div>
            <h2 class="font-display font-bold text-paper text-[28px] leading-tight tracking-[-0.02em]">¡Gracias! Te respondemos pronto.</h2>
            <p class="font-body text-body text-mute max-w-[44ch]">Revisá tu bandeja en las próximas 24 horas. Si es urgente, escribinos directo a <a href="mailto:hola@auditadigital.com" class="text-blue hover:text-paper transition-colors">hola@auditadigital.com</a>.</p>
            <a href="/" class="inline-flex items-center gap-2 font-mono text-[11px] text-mute-2 uppercase tracking-[0.08em] hover:text-paper transition-colors mt-2">
              ← Volver al inicio
            </a>
          </div>

        </div>
      </div>
    </div>
  </main>

  <footer class="border-t border-line bg-ink-2 py-6">
    <div class="mx-auto max-w-[1240px] px-6 flex flex-col md:flex-row gap-4 items-center justify-between">
      <p class="font-mono text-[11px] text-mute">© 2026 AuditaDigital</p>
      <div class="flex gap-6 font-mono text-[11px] text-mute-2 uppercase tracking-[0.08em]">
        <a href="/aviso-legal" class="hover:text-paper transition-colors">Aviso legal</a>
        <a href="/privacidad" class="hover:text-paper transition-colors">Privacidad</a>
        <a href="/contact" class="text-paper">Contacto</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field-label {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 11px;
    color: theme('colors.mute-2');
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .field-input {
    width: 100%;
    background: theme('colors.ink-3');
    border: 1px solid theme('colors.line');
    border-radius: var(--r-s, 4px);
    padding: 14px 16px;
    font-family: var(--font-body, 'Geist', sans-serif);
    font-size: 15px;
    color: theme('colors.paper');
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    -webkit-font-smoothing: antialiased;
  }
  .field-input::placeholder {
    color: theme('colors.mute');
  }
  .field-input:focus {
    border-color: theme('colors.blue');
    box-shadow: 0 0 0 3px rgba(46, 91, 255, 0.12);
  }
  .field-input.error {
    border-color: theme('colors.orange');
    box-shadow: 0 0 0 3px rgba(255, 92, 0, 0.1);
  }
  .submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: theme('colors.blue');
    color: theme('colors.paper');
    font-family: var(--font-display, 'Space Grotesk', sans-serif);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.005em;
    padding: 14px 22px;
    border: 0;
    border-radius: var(--r-s, 4px);
    cursor: pointer;
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.25);
    transition: background 0.12s ease, transform 0.12s ease;
  }
  .submit-btn:hover:not(:disabled) {
    background: #4a73ff;
    transform: translateY(-1px);
  }
  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<script>
  // Pre-fill form from query params (e.g. from mini-auditoria CTA)
  const searchParams = new URLSearchParams(window.location.search);
  const PREFILL_KEYS = ['nombre', 'email', 'asunto', 'mensaje'] as const;
  let prefilled = false;

  for (const key of PREFILL_KEYS) {
    const val = searchParams.get(key);
    if (val) {
      const el = document.getElementById(key) as HTMLInputElement | HTMLTextAreaElement | null;
      if (el) {
        el.value = val;
        prefilled = true;
      }
    }
  }

  if (prefilled) {
    const banner = document.getElementById('prefill-banner');
    if (banner) {
      banner.classList.remove('hidden');
      banner.classList.add('flex');
    }
    document.getElementById('contact-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text')!;
  const btnIcon = document.getElementById('btn-icon')!;
  const errorDiv = document.getElementById('form-error')!;
  const errorText = errorDiv.querySelector('.error-text')!;
  const successMsg = document.getElementById('success-msg')!;

  function showError(msg: string) {
    errorText.textContent = msg;
    errorDiv.classList.remove('hidden');
    errorDiv.classList.add('flex');
  }

  function resetBtn() {
    submitBtn.disabled = false;
    btnText.textContent = 'Enviar mensaje';
    btnIcon.textContent = '→';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');
    errorDiv.classList.remove('flex');

    const inputs = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.field-input');
    inputs.forEach(el => el.classList.remove('error'));

    const data = {
      nombre: (form.nombre as HTMLInputElement).value.trim(),
      email: (form.email as HTMLInputElement).value.trim(),
      asunto: (form.asunto as HTMLInputElement).value.trim(),
      mensaje: (form.mensaje as HTMLTextAreaElement).value.trim(),
    };

    submitBtn.disabled = true;
    btnText.textContent = 'Enviando…';
    btnIcon.textContent = '⋯';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const json = await res.json();

      if (!res.ok) {
        showError(json.error || 'Error al enviar. Intentá de nuevo.');
        resetBtn();
        return;
      }

      form.classList.add('hidden');
      successMsg.classList.remove('hidden');
      successMsg.classList.add('flex');
    } catch {
      showError('Error de conexión. Revisá tu red e intentá de nuevo.');
      resetBtn();
    }
  });
</script>
